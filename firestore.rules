rules_version = '2';

// Larder security rules.
// Roles live on each list doc: lists/{listId}.members[uid].role = 'manager' | 'stocker' | 'shopper'
//   manager: everything (the list's creator is always a manager)
//   stocker: edit pantry items, take the weekly count
//   shopper: see everything, add requests, mark things picked up
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function listDoc(listId) { return get(/databases/$(database)/documents/lists/$(listId)).data; }
    function isMember(listId) { return signedIn() && request.auth.uid in listDoc(listId).memberIds; }
    function hasRole(listId, roles) { return isMember(listId) && listDoc(listId).members[request.auth.uid].role in roles; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Public profile so managers can find people by email.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.emailLower == request.auth.token.email.lower();
      allow delete: if false;
    }

    match /lists/{listId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members[request.auth.uid].role == 'manager';

      allow update: if signedIn() && (
        // Managers can change anything, but the creator always stays a manager.
        (
          resource.data.members[request.auth.uid].role == 'manager'
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.members[resource.data.ownerId].role == 'manager'
          && request.resource.data.members.keys().toSet() == request.resource.data.memberIds.toSet()
        )
        // Stockers stamp the time of the count.
        || (
          resource.data.members[request.auth.uid].role == 'stocker'
          && changed().hasOnly(['lastCountAt'])
        )
        // Anyone except the creator can leave.
        || (
          request.auth.uid != resource.data.ownerId
          && request.auth.uid in resource.data.memberIds
          && changed().hasOnly(['members', 'memberIds'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
          && !(request.auth.uid in request.resource.data.members)
        )
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /items/{itemId} {
        allow read: if isMember(listId);
        allow create, delete: if hasRole(listId, ['manager', 'stocker']);
        // Shoppers may only bump the on-hand amount when they pick something up.
        allow update: if hasRole(listId, ['manager', 'stocker'])
          || (isMember(listId) && changed().hasOnly(['current', 'updatedAt']));
      }

      match /shopping/{entryId} {
        allow read, create, update: if isMember(listId);
        allow delete: if hasRole(listId, ['manager', 'stocker'])
          || (isMember(listId) && resource.data.addedBy.uid == request.auth.uid);
      }

      match /counts/{countId} {
        allow read: if isMember(listId);
        allow create: if hasRole(listId, ['manager', 'stocker']);
        allow update, delete: if hasRole(listId, ['manager']);
      }
    }
  }
}
